{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "ES2020",
    "moduleResolution": "bundler",
    "allowJs": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "lib": ["es2023", "dom"],
    "target": "ES2022",
    "types": ["node"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./src",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    },
    "useDefineForClassFields": false
  },
  "include": ["src/**/*", "src/loader.mjs", "src/preloader.mjs"],
  "exclude": ["node_modules", "dist"]
}
