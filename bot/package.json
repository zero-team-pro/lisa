{
  "name": "lisa",
  "version": "0.0.1",
  "license": "MIT",
  "main": "src/index.ts",
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --plugin prettier-plugin-sql --write .",
    "format:check": "prettier --plugin prettier-plugin-sql --check .",
    "format:staged": "pretty-quick --staged",
    "test": "yarn test:unit",
    "test:unit": "jest --config=jest.config.js --runInBand --coverage=false && yarn test:messages",
    "test:ci": "CI=1 jest --config=jest.config.js --runInBand --coverage && yarn test:messages",
    "verify": "yarn format:check && yarn typecheck && yarn test:unit",
    "verify:ci": "yarn format:check && yarn typecheck && yarn test:ci",
    "start-bot-gateway": "node --import ./src/preloader.mjs dist/gateway.js",
    "start-bot-cluster": "node --import ./src/preloader.mjs dist/cluster.js",
    "start-bot-telegram": "node --import ./src/preloader.mjs dist/telegram.js",
    "start-bot-vm": "node --import ./src/preloader.mjs dist/vm.js",
    "start-gateway": "run-s start-bot-gateway",
    "start-cluster": "run-s start-bot-cluster",
    "start-telegram": "run-s start-bot-telegram",
    "start-vm": "run-s start-bot-vm",
    "test:messages": "yarn build && node --import ./src/preloader.mjs --test tests/messages.test.mjs"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zero-team-pro/lisa.git"
  },
  "bugs": {
    "url": "https://github.com/zero-team-pro/lisa/issues"
  },
  "homepage": "https://github.com/zero-team-pro/lisa#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "amqplib": "0.10.9",
    "axios": "1.20.0",
    "body-parser": "1.20.8",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "cron": "4.4.0",
    "discord.js": "14.27.0",
    "dockerode": "4.0.12",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "extensionless": "2.0.6",
    "got": "16.1.0",
    "i18next": "21.10.0",
    "js-tiktoken": "1.0.21",
    "lodash": "4.18.1",
    "mastercard-oauth1-signer": "1.2.0",
    "mime-types": "2.1.35",
    "module-alias": "2.3.4",
    "node-fetch": "2.7.0",
    "openai": "7.34.0",
    "p-map": "7.1.1",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "prom-client": "15.1.3",
    "redis": "4.7.1",
    "reflect-metadata": "0.2.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "telegraf": "4.16.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "url-value-parser": "2.2.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/amqplib": "0.10.8",
    "@types/dockerode": "4.0.2",
    "@types/express": "4.17.25",
    "@types/mime-types": "2.1.4",
    "@types/node": "24.19.2",
    "@types/validator": "13.15.10",
    "cross-env": "10.1.0",
    "jest": "30.5.2",
    "jest-teamcity": "^1.12.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.4.2",
    "prettier-plugin-sql": "0.18.1",
    "pretty-quick": "4.2.2",
    "ts-jest": "29.4.14"
  },
  "resolutions": {
    "sql-formatter": "15.4.7",
    "@types/node": "24.19.2"
  }
}
